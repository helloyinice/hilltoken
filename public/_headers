# 品牌素材：先移除默认长缓存，再要求每次重新校验
# 否则浏览器会缓存同名 SVG 长达 4 小时，更新 Logo 后仍显示旧版
/assets/brand-kit/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# 根目录站点图标：每次重新校验，避免标签栏/主屏长期显示旧图标
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate
/favicon-32.png
  Cache-Control: public, max-age=0, must-revalidate
/favicon-16.png
  Cache-Control: public, max-age=0, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate
/safari-pinned-tab.svg
  Cache-Control: public, max-age=0, must-revalidate

# FSD V15 视频：单文件原生播放，走浏览器 Range 请求；CDN 整文件缓存保证流畅
/notes/fsd-v15-video/*.mp4
  Content-Type: video/mp4
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable

/notes/fsd-v15-video/
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# 旧版明文视频地址已废弃：返回纯文本占位，避免缓存中的旧文件继续被下载
/notes/fsd-v15-video/fsd-v15.mp4
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
