---
const nav = [
  { label: '关于这个名字', hint: '01 / Name', href: '#about' },
  { label: '在做的事', hint: '02 / Work', href: '#work' },
  { label: '文章', hint: '03 / Notes', href: '#notes' },
  { label: '友链', hint: '04 / Friends', href: '#friends' },
  { label: '给 Agent', hint: '05 / For Agents', href: '#for-agents' },
  { label: '品牌素材', hint: '06 / Brand', href: '/brand-kit/' },
];
---

<header class="mast">
  <div class="wrap mast-top">
    <div class="mast-brand">
      <a class="mast-logo" href="#top" aria-label="HillToken｜山外有词 · 返回首页">
        <img src="/assets/brand-kit/logo/hilltoken-logo-square-paper.svg" alt="HillToken 方形米纸底字标" width="68" height="68" />
      </a>
      <div class="mast-wordmark"><a class="mast-wordmark-name" href="#top">HillToken<span class="wm-divider">｜</span><span class="wm-tag">山外有词</span></a></div>
    </div>

    <nav class="mast-nav" aria-label="站内导航">
      {nav.map((item) => (
        <a class="mast-nav-link" href={item.href}>
          <span class="mnl-inner">
            <span class="mnl-face">{item.label}</span>
            <span class="mnl-face mnl-face--over" aria-hidden="true">{item.label}</span>
          </span>
          <span class="mnl-index" aria-hidden="true">{item.hint}</span>
        </a>
      ))}
    </nav>

    <a class="btn btn-dark btn-sm mast-subscribe" href="/rss.xml" aria-label="订阅 HillToken｜山外有词的 RSS 更新">订阅 RSS <span class="sub-arrow" aria-hidden="true">→</span></a>
  </div>
</header>
