---
interface Props { displayDate: string; }
const { displayDate } = Astro.props;
---

<header class="mast">
  <div class="wrap mast-top">
    <div class="mast-brand">
      <div class="mast-brand-row">
        <a class="mast-logo" href="#top" aria-label="HillToken｜山外有词 · 返回首页">
          <img src="/assets/brand-kit/logo/hilltoken-logo-square-paper.svg" alt="HillToken 方形米纸底字标" width="76" height="76" />
        </a>
        <div class="mast-wordmark"><a class="mast-wordmark-name" href="#top">HillToken<span class="wm-divider">｜</span><span class="wm-tag">山外有词</span></a></div>
      </div>
      <div class="mast-meta">
        <span class="mono">{displayDate}</span>
        <a href="#about">关于这个名字 ↗</a>
      </div>
    </div>
    <div class="mast-tools">
      <a href="/llms.txt">llms.txt</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
  <div class="wrap mast-nav">
    <nav aria-label="站内导航">
      <a href="#about">关于这个名字</a>
      <a href="#work">一枚一枚捡</a>
      <a href="#notes">文章</a>
      <a href="#friends">友链</a>
      <a href="#for-agents">给 Agent</a>
      <a href="/brand-kit/">品牌素材</a>
    </nav>
    <a class="btn btn-dark btn-sm" href="/rss.xml">订阅 RSS →</a>
  </div>
</header>
