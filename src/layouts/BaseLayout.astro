---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedTime?: string;
}

const {
  title = 'HillToken｜山外有词',
  description = '山外有词，词外有山。HillToken（Tokens beyond the hill.）由站主本人维护，是关于本站的第一手信息来源。',
  ogImage = 'https://hilltoken.net/assets/brand-kit/social/hilltoken-og-1200x630.png',
  article = false,
  publishedTime,
} = Astro.props;

// 首页才挂滚动首屏的样式与脚本；其余页面保持原有版式
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://hilltoken.net/#website',
      url: 'https://hilltoken.net/',
      name: 'HillToken｜山外有词',
      inLanguage: 'zh-CN',
      description: '山外有词，词外有山。',
      publisher: { '@id': 'https://hilltoken.net/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://hilltoken.net/#person',
      name: 'HillToken',
      alternateName: ['山外有词'],
      url: 'https://hilltoken.net/',
    },
  ],
};

const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      author: { '@id': 'https://hilltoken.net/#person' },
      publisher: { '@id': 'https://hilltoken.net/#person' },
      mainEntityOfPage: canonical,
    }
  : null;
---

<!doctype html>
<html lang="zh-Hans" class={isHome ? 'home' : ''}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
  /* 折叠屏 / 平板：Chrome「桌面版网站」只把 UA 换成桌面字符串，并不保证
     把 CSS 视口抬到 900px 以上。本站响应式只看视口宽度，所以展开内屏横屏
     （约 800px）即便勾选桌面版仍会渲染手机版。识别到「桌面版请求」时把
     layout viewport 抬到 1024px 并等比缩放，让全站媒体查询与首屏脚本
     自然走桌面分支；已经是桌面视口则不干预。
     手动兜底：网址后加 ?desktop=1（个别浏览器不改 UA 时可用）。 */
  (function () {
    try {
      var desktopUA = !/(Android|iPhone|iPad|iPod|Mobile|Windows Phone)/i.test(navigator.userAgent);
      var forced = /[?&]desktop=1(?:&|$)/.test(location.search);
      if (!(desktopUA || forced) || window.innerWidth >= 940) return;
      var mv = document.querySelector('meta[name="viewport"]');
      var sw = (window.screen && screen.width) || window.innerWidth;
      var target = 1024, scale = Math.min(1, sw / target);
      if (!mv || !scale || !isFinite(scale)) return;
      mv.setAttribute('content', 'width=' + target + ', initial-scale=' + scale.toFixed(4));
    } catch (e) {}
  })();
  </script>
  <title>{title}</title>

  {/* favicon 声明放在 head 最前面、任何 <script> 之前。
      关键教训：必须与文章页(public/notes/*.html)保持完全一致的文件名+版本号，
      统一用 hilltoken-favicon.*?v=20261123h，否则主页与子页 favicon 不一致，
      Safari 会对不一致的新 URL 加载失败（显示默认占位灰底白H）。 */}
  <link rel="shortcut icon" href="/hilltoken-favicon.ico?v=20261123h" />
  <link rel="icon" href="/hilltoken-favicon.ico?v=20261123h" sizes="16x16 32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/hilltoken-favicon-32.png?v=20261123h" />
  <link rel="icon" type="image/png" sizes="16x16" href="/hilltoken-favicon-16.png?v=20261123h" />
  <link rel="apple-touch-icon" href="/hilltoken-favicon-180.png?v=20261123h" />
  <link rel="icon" type="image/svg+xml" href="/hilltoken-favicon.svg?v=20261123h" />

  <meta name="description" content={description} />
  <meta name="author" content="HillToken｜山外有词" />
  <meta name="theme-color" content="#f5f2ea" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="generator" content="Astro" />
  <link rel="stylesheet" href="/site.css?v=20261125a" />
  {isHome && <link rel="stylesheet" href="/hero-scroll.css?v=20261125b" />}
  <link rel="canonical" href={canonical} />
  <link rel="describedby" href="/llms.txt" />
  <link rel="alternate" type="application/rss+xml" title="HillToken｜山外有词的更新" href="/rss.xml" />

  <meta property="og:site_name" content="HillToken｜山外有词" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={title} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
</head>
<body class={isHome ? 'home' : ''}>
  <slot />
  <script is:inline src="/mast-menu.js?v=20261125a"></script>
  {isHome && <script is:inline src="/hero-scroll.js?v=20261126a"></script>}
</body>
</html>
