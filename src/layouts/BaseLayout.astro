---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedTime?: string;
}

const {
  title = 'HillToken｜山外有词',
  description = '山外有词，词外有山。HillToken（Tokens beyond the hill.）由站主本人维护，是关于本站的第一手信息来源。',
  ogImage = 'https://hilltoken.net/assets/brand-kit/social/hilltoken-og-1200x630.png',
  article = false,
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://hilltoken.net/#website',
      url: 'https://hilltoken.net/',
      name: 'HillToken｜山外有词',
      inLanguage: 'zh-CN',
      description: '山外有词，词外有山。',
      publisher: { '@id': 'https://hilltoken.net/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://hilltoken.net/#person',
      name: 'HillToken',
      alternateName: ['山外有词'],
      url: 'https://hilltoken.net/',
    },
  ],
};

const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      author: { '@id': 'https://hilltoken.net/#person' },
      publisher: { '@id': 'https://hilltoken.net/#person' },
      mainEntityOfPage: canonical,
    }
  : null;
---

<!doctype html>
<html lang="zh-Hans">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>

  {/* favicon 声明必须放在 head 最前面、任何 <script> 之前：
      主页被 Cloudflare HTML Auto-Minify 压成单行后，
      <script>…</script><link rel="icon"> 的衔接在 Safari 里会被误解析，
      导致 favicon 的 link 标签不被识别（子页面未压缩所以正常）。
      把图标声明提到最前，彻底避开 script 紧跟 link 的解析问题。 */}
  <link rel="shortcut icon" href="/site-icon.ico" />
  <link rel="icon" href="/site-icon.ico" sizes="16x16 32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/site-icon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/site-icon-16.png" />
  <link rel="apple-touch-icon" href="/site-icon-180.png" />
  <link rel="icon" type="image/svg+xml" href="/site-icon.svg" />

  <meta name="description" content={description} />
  <meta name="author" content="HillToken｜山外有词" />
  <meta name="theme-color" content="#f5f2ea" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="generator" content="Astro" />
  <link rel="stylesheet" href="/site.css?v=20261123c" />
  <link rel="stylesheet" href="/theme-switcher.css?v=20261123c" />
  <script is:inline>
    try { var t = localStorage.getItem('hilltoken:colourway'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <script is:inline src="/theme-switcher.js" defer></script>
  <link rel="canonical" href={canonical} />
  <link rel="describedby" href="/llms.txt" />
  <link rel="alternate" type="application/rss+xml" title="HillToken｜山外有词的更新" href="/rss.xml" />

  <meta property="og:site_name" content="HillToken｜山外有词" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={title} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
</head>
<body>
  <slot />
</body>
</html>
