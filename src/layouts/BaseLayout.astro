---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedTime?: string;
}

const {
  title = 'HillToken｜山外有词',
  description = '山外有词，词外有山。HillToken（Tokens beyond the hill.）由站主本人维护，是关于本站的第一手信息来源。',
  ogImage = 'https://hilltoken.net/assets/brand-kit/social/hilltoken-og-1200x630.png',
  article = false,
  publishedTime,
} = Astro.props;

// 首页才挂滚动首屏的样式与脚本；其余页面保持原有版式
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://hilltoken.net/#website',
      url: 'https://hilltoken.net/',
      name: 'HillToken｜山外有词',
      inLanguage: 'zh-CN',
      description: '山外有词，词外有山。',
      publisher: { '@id': 'https://hilltoken.net/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://hilltoken.net/#person',
      name: 'HillToken',
      alternateName: ['山外有词'],
      url: 'https://hilltoken.net/',
    },
  ],
};

const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      author: { '@id': 'https://hilltoken.net/#person' },
      publisher: { '@id': 'https://hilltoken.net/#person' },
      mainEntityOfPage: canonical,
    }
  : null;
---

<!doctype html>
<html lang="zh-Hans" class={isHome ? 'home' : ''}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
  /* 折叠屏 / 平板：让「桌面版」这个意图真正落到布局上。
     本站响应式只看视口宽度（900 断点），而 Chrome「桌面版网站」在各 ROM 上
     行为不一致：有的换 UA，有的保留 Android 字样只改默认宽度（还会被页面
     meta 的 width=device-width 覆盖）。只靠 UA 判断会漏，所以用三个独立信号：
       1) navigator.userAgentData.mobile === false（桌面版模式会置 false）
       2) UA 里没有 Mobile / iPhone / iPad（不再排除 Android——桌面版模式可能保留）
       3) 设备本身够宽：横屏、短边 ≥700 且长边 <1280（折叠屏内屏、小平板）
     命中且布局宽度不足 940 时，把 layout viewport 抬到 1024 并等比缩放，
     全站媒体查询与首屏脚本自然走桌面分支；已是桌面视口则不干预。
     折叠屏展开内屏时页面通常不重新加载，只触发 resize，所以判断做成可重入：
     每次尺寸变化重新评估，不再需要桌面版时把 viewport 还原。
     开关：?desktop=1 强制桌面版，?mobile=1 强制手机版，选择记进 localStorage。
     诊断：?dk=1 会在右下角打印实际生效的参数。 */
  (function () {
    try {
      var mv = document.querySelector('meta[name="viewport"]');
      if (!mv) return;
      var TARGET = 1024, BP = 940;
      var q = location.search, pref = null;
      try { pref = localStorage.getItem('ht-view'); } catch (e) {}
      if (/[?&]desktop=1(?:&|$)/.test(q)) pref = 'desktop';
      else if (/[?&]mobile=1(?:&|$)/.test(q)) pref = 'mobile';
      if (pref) { try { localStorage.setItem('ht-view', pref); } catch (e) {} }

      var ua = navigator.userAgent || '';
      var uad = navigator.userAgentData;

      function uaDesktop() {
        return (uad && uad.mobile === false) ? true
          : !/Mobile|iPhone|iPad|iPod|Windows Phone/i.test(ua);
      }
      function geoDesktop() {
        var sw = screen.width || innerWidth || 0, sh = screen.height || innerHeight || 0;
        var shortSide = Math.min(sw, sh), longSide = Math.max(sw, sh);
        return innerWidth > innerHeight && shortSide >= 700 && longSide < 1280;
      }
      function want() {
        if (pref === 'mobile') return false;
        if (pref === 'desktop') return true;
        return uaDesktop() || geoDesktop();
      }
      function availWidth() {
        var sw = screen.width || innerWidth || 0, sh = screen.height || innerHeight || 0;
        var longSide = Math.max(sw, sh), shortSide = Math.min(sw, sh);
        var w = innerWidth || shortSide;
        return w > longSide ? shortSide : w;
      }
      function marked() { return document.documentElement.getAttribute('data-dk') === '1'; }

      function apply() {
        if (!want()) {
          if (marked()) {
            mv.setAttribute('content', 'width=device-width, initial-scale=1');
            document.documentElement.removeAttribute('data-dk');
          }
          return;
        }
        var w = availWidth();
        if (w >= BP) return;
        var scale = Math.min(1, w / TARGET);
        if (!(scale > 0) || !isFinite(scale)) return;
        var next = 'width=' + TARGET + ', initial-scale=' + scale.toFixed(4);
        if (mv.getAttribute('content') !== next) {
          mv.setAttribute('content', next);
          document.documentElement.setAttribute('data-dk', '1');
        }
      }

      apply();

      var timer = null;
      function resync() {
        if (timer) clearTimeout(timer);
        timer = setTimeout(apply, 350);
      }
      window.addEventListener('resize', resync, { passive: true });
      window.addEventListener('orientationchange', resync);

      if (/[?&]dk=1(?:&|$)/.test(q)) {
        document.addEventListener('DOMContentLoaded', function () {
          var d = document.createElement('pre');
          d.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:9999;margin:0;padding:8px 10px;' +
            'background:#111;color:#7dff9a;font:11px/1.5 ui-monospace,SFMono-Regular,monospace;' +
            'white-space:pre-wrap;max-width:92vw;border-radius:6px;opacity:.94';
          document.body.appendChild(d);
          function draw() {
            var v = document.querySelector('.vid.on') || document.querySelector('.vid');
            var vs = v ? ('video: ' + (v.paused ? 'PAUSED' : 'playing') +
              ' ct=' + (v.currentTime || 0).toFixed(2) + ' rs=' + v.readyState +
              ' ns=' + v.networkState + ' muted=' + v.muted +
              ' err=' + (v.error ? v.error.code + ':' + v.error.message : 'none') +
              '\n       ' + (v.currentSrc || '').split('/').slice(-2).join('/')) : 'video: none';
            d.textContent = 'mode=' + (marked() ? 'desktop-forced' : 'native')
              + '\ninnerW=' + innerWidth + ' h=' + innerHeight
              + ' mq900=' + matchMedia('(max-width:900px)').matches
              + '\nmeta=' + mv.getAttribute('content')
              + '\nscreen=' + screen.width + 'x' + screen.height
              + ' uadMobile=' + (uad ? uad.mobile : 'n/a')
              + '\nwant=' + want() + ' ua=' + uaDesktop() + ' geo=' + geoDesktop()
              + '\nua=' + ua.slice(0, 100)
              + '\n' + vs;
          }
          draw();
          setInterval(draw, 1000);   // ct 每秒刷新，可判断画面是否真在推进
        });
      }
    } catch (e) {}
  })();
  </script>
  <title>{title}</title>

  {/* favicon 声明放在 head 最前面、任何 <script> 之前。
      关键教训：必须与文章页(public/notes/*.html)保持完全一致的文件名+版本号，
      统一用 hilltoken-favicon.*?v=20261123h，否则主页与子页 favicon 不一致，
      Safari 会对不一致的新 URL 加载失败（显示默认占位灰底白H）。 */}
  <link rel="shortcut icon" href="/hilltoken-favicon.ico?v=20261123h" />
  <link rel="icon" href="/hilltoken-favicon.ico?v=20261123h" sizes="16x16 32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/hilltoken-favicon-32.png?v=20261123h" />
  <link rel="icon" type="image/png" sizes="16x16" href="/hilltoken-favicon-16.png?v=20261123h" />
  <link rel="apple-touch-icon" href="/hilltoken-favicon-180.png?v=20261123h" />
  <link rel="icon" type="image/svg+xml" href="/hilltoken-favicon.svg?v=20261123h" />

  <meta name="description" content={description} />
  <meta name="author" content="HillToken｜山外有词" />
  <meta name="theme-color" content="#f5f2ea" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="generator" content="Astro" />
  <link rel="stylesheet" href="/site.css?v=20261125a" />
  {isHome && <link rel="stylesheet" href="/hero-scroll.css?v=20261126d" />}
  <link rel="canonical" href={canonical} />
  <link rel="describedby" href="/llms.txt" />
  <link rel="alternate" type="application/rss+xml" title="HillToken｜山外有词的更新" href="/rss.xml" />

  <meta property="og:site_name" content="HillToken｜山外有词" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:locale" content="zh_CN" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={title} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
</head>
<body class={isHome ? 'home' : ''}>
  <slot />
  <script is:inline src="/mast-menu.js?v=20261125a"></script>
  {isHome && <script is:inline src="/hero-scroll.js?v=20261126d"></script>}
</body>
</html>
